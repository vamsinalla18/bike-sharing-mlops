{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1, "title": "API available", "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"bike-prediction-api\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2, "title": "Prediction requests / second", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (status) (rate(prediction_requests_total[$__rate_interval]))", "legendFormat": "{{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 18, "x": 6, "y": 0}
    },
    {
      "id": 3, "title": "Prediction latency p95", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(prediction_request_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 4, "title": "Prediction requests, last 5 minutes", "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(increase(prediction_requests_total[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8}
    },
    {
      "id": 5, "title": "HTTP request rate", "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(http_request_duration_seconds_count[$__rate_interval]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8}
    }
  ],
  "schemaVersion": 40,
  "tags": ["bike-sharing", "mlops"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "title": "Bike Sharing API",
  "uid": "bike-sharing-api",
  "version": 1
}
